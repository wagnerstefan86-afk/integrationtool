# ─────────────────────────────────────────────────────────────
# Harmonizer — Deployment Configuration
# Copy to .env and adjust as needed:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Environment tag (shown in health endpoint and logs)
APP_ENV=production

# ─── Ports ────────────────────────────────────────────────────
BACKEND_PORT=8001
FRONTEND_PORT=3001

# ─── Persistent host paths (mounted into containers) ─────────
# These directories MUST exist before starting containers.
# Use scripts/start.sh to create them automatically.
DATA_PATH=./deploy/data
REPORT_PATH=./deploy/reports
LOG_PATH=./deploy/logs

# ─── Version tracing (set automatically by scripts/start.sh) ─
# APP_VERSION=0.9.0
# GIT_COMMIT=abc1234
# BUILD_DATE=2026-04-03T12:00:00Z
